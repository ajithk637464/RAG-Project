# Copy this file to .env and fill in real values. Never commit .env itself.

# "ollama" (default) = free, runs locally, no API key needed.
# "openai" = paid, needs a real OPENAI_API_KEY below with billing set up.
LLM_PROVIDER=ollama

OPENAI_API_KEY=your-openai-api-key-here

# Only needed if you want a different local model than the default (llama3.2).
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Week 7 agent safeguards (optional — defaults live in config.py).
# AGENT_MAX_STEPS=8
# AGENT_TIMEOUT_SECONDS=180
# AGENT_MAX_TOTAL_TOKENS=12000
